      "id": "roles",
      "repository": "Bittrees-Technology/roles",
      "branch": "main",
      "manifestPath": "bittrees.tools.json",
      "routes": [
        {
          "transport": "local-mcp-adapter",
          "endpoint": "https://roles.bittrees.org/api/integrations/ai",
          "setup": {
            "command": "node",
            "args": [
              "integrations/app-api-mcp.mjs"
            ],
            "environmentNames": [
              "BITTREES_APP",
              "BITTREES_APP_TOKEN"
            ],
            "app": "roles",
            "credential": "Use an existing app-scoped credential through secret storage; never send credentials as tool arguments."
          }
        }
      ],
      "publicManifestUrl": "https://roles.bittrees.org/.well-known/bittrees-tools.json"
    },
