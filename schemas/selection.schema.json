{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp.bittrees.org/schemas/selection.schema.json",
  "type": "object",
  "required": [
    "schema",
    "version",
    "revision",
    "mode",
    "selectedIds",
    "excludedIds"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "agent.bittrees.selection.v1"
    },
    "version": {
      "const": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "mode": {
      "enum": [
        "selected",
        "bittrees",
        "ecosystem"
      ]
    },
    "selectedIds": {
      "type": "array",
      "maxItems": 300,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
      }
    },
    "excludedIds": {
      "type": "array",
      "maxItems": 300,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
      }
    }
  }
}
